<?xml version="1.0" encoding="utf-8"?>
<elements>
	<!-- A species in the older style: it carries its own ability score increase, which a background with its own increase turns off. -->
	<element name="Hollowfolk" type="Race" source="Hollow Realms" id="ID_SF_RACE_HOLLOWFOLK">
		<description><p>Stout dwellers of the hollow hills, practical and slow to anger.</p></description>
		<setters><set name="height">4 to 5 feet</set></setters>
		<rules>
			<stat name="constitution" value="2" requirements="!ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<stat name="speed" value="25" />
			<grant type="Racial Trait" id="ID_SF_TRAIT_HOLLOWFOLK_STURDY" />
			<select type="Sub Race" name="Hill kin" supports="ID_SF_SUBRACE_STONEKIN|ID_SF_SUBRACE_DEEPKIN" />
		</rules>
	</element>
	<element name="Sturdy" type="Racial Trait" source="Hollow Realms" id="ID_SF_TRAIT_HOLLOWFOLK_STURDY">
		<description><p>You have advantage on saving throws against being knocked prone.</p></description>
		<sheet display="true"><description>You have advantage on saving throws against being knocked prone.</description></sheet>
	</element>
	<element name="Stonekin" type="Sub Race" source="Hollow Realms" id="ID_SF_SUBRACE_STONEKIN">
		<description><p>Your wisdom increases by 1.</p></description>
		<rules><stat name="wisdom" value="1" requirements="!ID_INTERNAL_GRANTS_BACKGROUND_ASI" /></rules>
	</element>
	<element name="Deepkin" type="Sub Race" source="Hollow Realms" id="ID_SF_SUBRACE_DEEPKIN">
		<description><p>Your strength increases by 1.</p></description>
		<rules><stat name="strength" value="1" requirements="!ID_INTERNAL_GRANTS_BACKGROUND_ASI" /></rules>
	</element>

	<!-- A species in the newer style: no ability score increase of its own. -->
	<element name="Emberkin" type="Race" source="Hollow Realms" id="ID_SF_RACE_EMBERKIN">
		<description><p>Descendants of a forgotten forge-spirit, warm to the touch.</p></description>
		<rules>
			<stat name="speed" value="30" />
			<grant type="Racial Trait" id="ID_SF_TRAIT_EMBERKIN_WARMTH" />
			<select type="Racial Trait" name="Ember gift" supports="Ember Gift" />
			<select type="Proficiency" name="Keen senses" supports="Skill,Wisdom" />
		</rules>
	</element>
	<element name="Inner Warmth" type="Racial Trait" source="Hollow Realms" id="ID_SF_TRAIT_EMBERKIN_WARMTH">
		<description><p>You resist cold.</p></description>
		<sheet display="true"><description>You resist cold.</description></sheet>
	</element>
	<element name="Spark" type="Racial Trait" source="Hollow Realms" id="ID_SF_GIFT_SPARK"><supports>Ember Gift</supports><description><p>You can light small flames.</p></description></element>
	<element name="Glow" type="Racial Trait" source="Hollow Realms" id="ID_SF_GIFT_GLOW"><supports>Ember Gift</supports><description><p>You can shed dim light.</p></description></element>
</elements>
