			<set name="category">Armor</set><set name="cost" currency="gp">75</set><set name="weight" lb="55">55 lb.</set><set name="slot">body</set>
			<set name="armor">Heavy</set><set name="strength">13</set><set name="stealth">Disadvantage</set><set name="armorClass">16</set>
			<set name="proficiency">ID_PROFICIENCY_ARMOR_PROFICIENCY_HEAVY_ARMOR</set>
