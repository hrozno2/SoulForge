{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default window permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api-free.deepl.com/*"
        },
        {
          "url": "https://api.deepl.com/*"
        },
        {
          "url": "https://media.wizards.com/*"
        },
        {
          "url": "https://media.dndbeyond.com/*"
        },
        {
          "url": "https://drive.usercontent.google.com/*"
        },
        {
          "url": "https://drive.google.com/*"
        }
      ]
    }
  ]
}
