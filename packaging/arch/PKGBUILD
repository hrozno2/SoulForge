# Maintainer: hrozno2/SoulForge <https://github.com/hrozno2/SoulForge>
pkgname=soulforge-bin
_name=SoulForge
pkgver=0.2.0
pkgrel=1
pkgdesc="D&D 5e (2024) character builder with custom modifiers, content import and PDF export"
arch=('x86_64' 'aarch64')
url="https://github.com/hrozno2/SoulForge"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
provides=('soulforge' 'charforge')
conflicts=('soulforge' 'charforge' 'charforge-bin')
options=('!strip' '!debug')
noextract=("${pkgname}-${pkgver}-x86_64.deb" "${pkgname}-${pkgver}-aarch64.deb")
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::${url}/releases/download/v${pkgver}/${_name}_${pkgver}_amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-aarch64.deb::${url}/releases/download/v${pkgver}/${_name}_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local deb="${srcdir}/${pkgname}-${pkgver}-${CARCH}.deb"
  mkdir -p "${srcdir}/deb"
  cd "${srcdir}/deb"
  bsdtar -xf "${deb}"
  bsdtar -xf data.tar.* -C "${pkgdir}"
  # The menu entry is named after the window's app id (charforge), so the taskbar matches it, and is called
  # "Soul Forge"; a soulforge command sits beside charforge (GitHub issue #2).
  local apps="${pkgdir}/usr/share/applications"
  if [ -f "${apps}/SoulForge.desktop" ]; then mv "${apps}/SoulForge.desktop" "${apps}/charforge.desktop"; fi
  if [ -f "${apps}/charforge.desktop" ]; then sed -i 's/^Name=.*/Name=Soul Forge/' "${apps}/charforge.desktop"; fi
  ln -sf charforge "${pkgdir}/usr/bin/soulforge"
}
